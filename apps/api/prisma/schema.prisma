datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String?   @map("password_hash")
  firstName       String?   @map("first_name")
  lastName        String?   @map("last_name")
  isEmailVerified Boolean   @default(false) @map("is_email_verified")
  status          String    @default("ACTIVE") // ACTIVE, INVITED, SUSPENDED
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  memberships             OrganizationMembership[]
  auditLogs               AuditLog[]
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  sentInvitations         Invitation[]             @relation("UserSentInvitations")
  headedDepartments       Department[]             @relation("DepartmentHead")
  employees               Employee[]

  @@index([email])
  @@map("users")
}

model Organization {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  status    String    @default("ACTIVE") // ACTIVE, SUSPENDED
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  memberships    OrganizationMembership[]
  products       OrganizationProduct[]
  roles          Role[]
  userRoles      UserRole[]
  auditLogs      AuditLog[]
  invitations    Invitation[]
  profile        CompanyProfile?
  locations      Location[]
  departments    Department[]
  grades         Grade[]
  designations   Designation[]
  workweekConfig WorkweekConfig?
  holidays       Holiday[]
  employees               Employee[]
  employmentHistories     EmploymentHistory[]
  employeeCodeSequence    EmployeeCodeSequence?
  employeeImportJobs      EmployeeImportJob[]
  employeeExportJobs      EmployeeExportJob[]
  workflowRules           WorkflowRule[]
  workflowExecutions      WorkflowExecution[]
  approvalFlows           ApprovalFlow[]
  checklists              Checklist[]
  checklistRuns           ChecklistRun[]
  tasks                   Task[]
  delegations             Delegation[]

  @@index([slug])
  @@map("organizations")
}

model OrganizationMembership {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  organizationId String    @map("organization_id")
  status         String    @default("ACTIVE") // ACTIVE, INVITED, SUSPENDED
  joinedAt       DateTime? @map("joined_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userRoles    UserRole[]

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("organization_memberships")
}

model OrganizationProduct {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  productCode    String    @map("product_code") // ZENTRA_PEOPLE, ZENTRA_PAYROLL
  status         String    @default("ACTIVE") // ACTIVE, TRIAL, EXPIRED, CANCELLED
  trialEndsAt    DateTime? @map("trial_ends_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, productCode])
  @@index([organizationId])
  @@map("organization_products")
}

model Role {
  id             String   @id @default(uuid())
  organizationId String?  @map("organization_id") // Null for global base roles, or scoped to org
  name           String
  code           String   // SUPER_ADMIN, HR_ADMIN, MANAGER, EMPLOYEE, or custom
  description    String?
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]
  invitations     Invitation[]

  @@index([organizationId])
  @@index([code])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique // auth.manage, organization.read, etc.
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@index([code])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  membershipId   String   @map("membership_id")
  roleId         String   @map("role_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role                   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([membershipId, roleId])
  @@index([organizationId])
  @@index([membershipId])
  @@index([roleId])
  @@map("user_roles")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?  @map("organization_id")
  actorUserId    String?  @map("actor_user_id")
  action         String
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  oldValues      Json?    @map("old_values")
  newValues      Json?    @map("new_values")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actorUser    User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model Invitation {
  id              String    @id @default(uuid())
  organizationId  String    @map("organization_id")
  email           String
  roleId          String    @map("role_id")
  invitedByUserId String    @map("invited_by_user_id")
  tokenHash       String    @unique @map("token_hash")
  status          String    @default("PENDING") // PENDING, ACCEPTED, EXPIRED, REVOKED
  expiresAt       DateTime  @map("expires_at")
  acceptedAt      DateTime? @map("accepted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role          Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  invitedByUser User         @relation("UserSentInvitations", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([tokenHash])
  @@index([status])
  @@map("invitations")
}

// ==========================================
// ORGANIZATION SETUP MODELS
// ==========================================

model CompanyProfile {
  id                  String   @id @default(uuid())
  organizationId      String   @unique @map("organization_id")
  legalName           String?  @map("legal_name")
  logoUrl             String?  @map("logo_url")
  website             String?
  industry            String?
  companySize         String?  @map("company_size")
  registrationNumber  String?  @map("registration_number")
  taxIdNumber         String?  @map("tax_id_number")
  country             String?
  state               String?
  city                String?
  address             String?
  timezone            String?
  defaultCurrency     String?  @map("default_currency")
  primaryContactName  String?  @map("primary_contact_name")
  primaryContactEmail String?  @map("primary_contact_email")
  primaryContactPhone String?  @map("primary_contact_phone")
  description         String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("company_profiles")
}

model Location {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  name           String
  code           String
  country        String
  state          String?
  city           String
  address        String
  postalCode     String?   @map("postal_code")
  timezone       String
  phone          String?
  email          String?
  isHeadquarters Boolean   @default(false) @map("is_headquarters")
  status         String    @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  holidays            Holiday[]
  employees           Employee[]
  employmentHistories EmploymentHistory[]

  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([status])
  @@map("locations")
}

model Department {
  id                   String    @id @default(uuid())
  organizationId       String    @map("organization_id")
  name                 String
  code                 String
  parentDepartmentId   String?   @map("parent_department_id")
  departmentHeadUserId String?   @map("department_head_user_id")
  description          String?
  status               String    @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  organization       Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentDepartment   Department?   @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id], onDelete: SetNull)
  childDepartments   Department[]  @relation("DepartmentHierarchy")
  departmentHeadUser  User?               @relation("DepartmentHead", fields: [departmentHeadUserId], references: [id], onDelete: SetNull)
  designations        Designation[]
  employees           Employee[]
  employmentHistories EmploymentHistory[]

  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([parentDepartmentId])
  @@index([status])
  @@map("departments")
}

model Grade {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  name           String
  code           String
  level          Int
  description    String?
  status         String    @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  designations        Designation[]
  employees           Employee[]
  employmentHistories EmploymentHistory[]

  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@unique([organizationId, level])
  @@index([organizationId])
  @@index([status])
  @@map("grades")
}

model Designation {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  name           String
  code           String
  gradeId        String?   @map("grade_id")
  departmentId   String?   @map("department_id")
  description    String?
  status         String    @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  grade        Grade?       @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  department          Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employees           Employee[]
  employmentHistories EmploymentHistory[]

  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([gradeId])
  @@index([departmentId])
  @@index([status])
  @@map("designations")
}

model WorkweekConfig {
  id                   String   @id @default(uuid())
  organizationId       String   @unique @map("organization_id")
  weeklyWorkingDays    Json     @map("weekly_working_days") // String array ["MONDAY", "TUESDAY", ...]
  weekendDays          Json     @map("weekend_days") // String array ["SATURDAY", "SUNDAY"]
  dailyStartTime       String   @default("09:00") @map("daily_start_time")
  dailyEndTime         String   @default("18:00") @map("daily_end_time")
  breakDurationMinutes Int      @default(60) @map("break_duration_minutes")
  timezone             String   @default("UTC")
  effectiveFrom        DateTime @default(now()) @map("effective_from")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("workweek_configs")
}

model Holiday {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  date           DateTime
  type           String   @default("PUBLIC") // PUBLIC, OPTIONAL, RESTRICTED
  locationId     String?  @map("location_id")
  description    String?
  isRecurring    Boolean  @default(false) @map("is_recurring")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([date])
  @@index([locationId])
  @@map("holidays")
}


// ==========================================
// EMPLOYEE MANAGEMENT MODELS
// ==========================================

model Employee {
  id                    String    @id @default(uuid())
  organizationId        String    @map("organization_id")
  userId                String?   @map("user_id")
  employeeCode          String    @map("employee_code")
  firstName             String    @map("first_name")
  middleName            String?   @map("middle_name")
  lastName              String    @map("last_name")
  workEmail             String    @map("work_email")
  personalEmail         String?   @map("personal_email")
  phone                 String
  dateOfBirth           DateTime? @map("date_of_birth")
  gender                String?   // MALE, FEMALE, NON_BINARY, OTHER, PREFER_NOT_TO_SAY
  maritalStatus         String?   @map("marital_status") // SINGLE, MARRIED, DIVORCED, WIDOWED
  bloodGroup            String?   @map("blood_group") // A_POSITIVE, B_POSITIVE, O_POSITIVE, etc.
  nationality           String?
  currentAddress        String?   @map("current_address")
  permanentAddress      String?   @map("permanent_address")
  city                  String?
  state                 String?
  country               String?
  postalCode            String?   @map("postal_code")
  emergencyContactName  String?   @map("emergency_contact_name")
  emergencyContactPhone String?   @map("emergency_contact_phone")
  emergencyContactRel   String?   @map("emergency_contact_relationship")
  profilePhotoUrl       String?   @map("profile_photo_url")
  dateOfJoining         DateTime  @map("date_of_joining")
  probationEndDate      DateTime? @map("probation_end_date")
  employmentType        String    @default("FULL_TIME") @map("employment_type") // FULL_TIME, PART_TIME, CONTRACT, INTERN, TEMPORARY
  status                String    @default("ACTIVE") // INVITED, ACTIVE, ON_PROBATION, ON_NOTICE_PERIOD, ON_LONG_LEAVE, SUSPENDED, INACTIVE, RESIGNED, TERMINATED, EXITED
  locationId            String    @map("location_id")
  departmentId          String    @map("department_id")
  designationId         String    @map("designation_id")
  gradeId               String?   @map("grade_id")
  reportingManagerId    String?   @map("reporting_manager_id")
  workLocationId        String?   @map("work_location_id")
  dateOfExit            DateTime? @map("date_of_exit")
  exitReason            String?   @map("exit_reason")
  customFields          Json?     @default("{}") @map("custom_fields")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user              User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  location          Location            @relation(fields: [locationId], references: [id])
  department        Department          @relation(fields: [departmentId], references: [id])
  designation       Designation         @relation(fields: [designationId], references: [id])
  grade             Grade?              @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  reportingManager  Employee?           @relation("ManagerReportees", fields: [reportingManagerId], references: [id], onDelete: SetNull)
  reportees         Employee[]          @relation("ManagerReportees")
  employmentHistory EmploymentHistory[]

  @@unique([organizationId, employeeCode])
  @@unique([organizationId, workEmail])
  @@index([organizationId])
  @@index([employeeCode])
  @@index([workEmail])
  @@index([status])
  @@index([departmentId])
  @@index([locationId])
  @@index([designationId])
  @@index([reportingManagerId])
  @@map("employees")
}

model EmploymentHistory {
  id                 String    @id @default(uuid())
  organizationId     String    @map("organization_id")
  employeeId         String    @map("employee_id")
  eventType          String    @map("event_type") // JOINED, TRANSFERRED, PROMOTED, DESIGNATION_CHANGED, etc.
  effectiveFrom      DateTime  @map("effective_from")
  effectiveTo        DateTime? @map("effective_to")
  locationId         String?   @map("location_id")
  departmentId       String?   @map("department_id")
  designationId      String?   @map("designation_id")
  gradeId            String?   @map("grade_id")
  reportingManagerId String?   @map("reporting_manager_id")
  employmentType     String?   @map("employment_type")
  employeeStatus     String?   @map("employee_status")
  remarks            String?
  previousValues     Json?     @map("previous_values")
  newValues          Json?     @map("new_values")
  changedByUserId    String?   @map("changed_by_user_id")
  createdAt          DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  location     Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation  Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)
  grade        Grade?       @relation(fields: [gradeId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([employeeId])
  @@index([eventType])
  @@index([effectiveFrom])
  @@map("employment_histories")
}

model EmployeeCodeSequence {
  id             String   @id @default(uuid())
  organizationId String   @unique @map("organization_id")
  prefix         String   @default("ZEN-")
  nextNumber     Int      @default(1) @map("next_number")
  padding        Int      @default(4)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("employee_code_sequences")
}

model EmployeeImportJob {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  status          String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  fileName        String   @map("file_name")
  totalRows       Int      @default(0) @map("total_rows")
  processedRows   Int      @default(0) @map("processed_rows")
  successfulRows  Int      @default(0) @map("successful_rows")
  failedRows      Int      @default(0) @map("failed_rows")
  errors          Json?    @default("[]")
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("employee_import_jobs")
}

model EmployeeExportJob {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  status          String   @default("COMPLETED") // PENDING, COMPLETED, FAILED
  fileName        String   @map("file_name")
  fileContent     String   @map("file_content")
  totalRecords    Int      @default(0) @map("total_records")
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("employee_export_jobs")
}

// ==========================================
// WORKFLOW & APPROVAL ENGINE MODELS
// ==========================================

model WorkflowRule {
  id                 String    @id @default(uuid())
  organizationId     String    @map("organization_id")
  name               String
  description        String?
  module             String    @default("people")
  entityType         String    @map("entity_type")
  triggerEvent       String    @map("trigger_event")
  conditions         Json      @default("[]")
  conditionMatchType String    @default("ALL") @map("condition_match_type") // ALL, ANY
  isActive           Boolean   @default(true) @map("is_active")
  priority           Int       @default(0)
  createdBy          String?   @map("created_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actions      WorkflowAction[]
  executions   WorkflowExecution[]

  @@index([organizationId])
  @@index([module])
  @@index([entityType])
  @@index([triggerEvent])
  @@index([isActive])
  @@map("workflow_rules")
}

model WorkflowAction {
  id             String   @id @default(uuid())
  workflowRuleId String   @map("workflow_rule_id")
  actionType     String   @map("action_type")
  actionConfig   Json     @map("action_config")
  executionOrder Int      @default(1) @map("execution_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  workflowRule WorkflowRule @relation(fields: [workflowRuleId], references: [id], onDelete: Cascade)

  @@index([workflowRuleId])
  @@map("workflow_actions")
}

model WorkflowExecution {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  workflowRuleId String    @map("workflow_rule_id")
  entityType     String    @map("entity_type")
  entityId       String    @map("entity_id")
  triggerEvent   String    @map("trigger_event")
  status         String    @default("pending") // pending, running, completed, failed, cancelled
  context        Json?     @default("{}")
  errorMessage   String?   @map("error_message")
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflowRule WorkflowRule @relation(fields: [workflowRuleId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([workflowRuleId])
  @@index([entityType, entityId])
  @@index([status])
  @@map("workflow_executions")
}

model ApprovalFlow {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  requestType    String    @map("request_type") // profile_change, etc.
  entityType     String    @map("entity_type")
  entityId       String    @map("entity_id")
  requestedBy    String    @map("requested_by")
  currentStep    Int       @default(1) @map("current_step")
  status         String    @default("pending") // draft, pending, approved, rejected, cancelled, expired, escalated
  initiatedAt    DateTime  @default(now()) @map("initiated_at")
  completedAt    DateTime? @map("completed_at")
  metadata       Json?     @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  steps        ApprovalStep[]

  @@index([organizationId])
  @@index([requestType])
  @@index([entityType, entityId])
  @@index([requestedBy])
  @@index([status])
  @@map("approval_flows")
}

model ApprovalStep {
  id             String    @id @default(uuid())
  approvalFlowId String    @map("approval_flow_id")
  stepOrder      Int       @map("step_order")
  stepName       String    @map("step_name")
  approverType   String    @map("approver_type") // reporting_manager, department_head, specific_user, etc.
  approverId     String?   @map("approver_id")
  approverRole   String?   @map("approver_role")
  status         String    @default("waiting") // pending, approved, rejected, skipped, waiting
  decision       String?
  comments       String?
  decidedBy      String?   @map("decided_by")
  decidedAt      DateTime? @map("decided_at")
  dueDate        DateTime? @map("due_date")
  escalatedAt    DateTime? @map("escalated_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  approvalFlow ApprovalFlow @relation(fields: [approvalFlowId], references: [id], onDelete: Cascade)

  @@index([approvalFlowId])
  @@index([approverId])
  @@index([status])
  @@index([dueDate])
  @@map("approval_steps")
}

model Checklist {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  name           String
  description    String?
  module         String    @default("people")
  entityType     String    @map("entity_type")
  triggerEvent   String?   @map("trigger_event")
  isActive       Boolean   @default(true) @map("is_active")
  createdBy      String?   @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        ChecklistItem[]
  runs         ChecklistRun[]

  @@index([organizationId])
  @@index([entityType])
  @@index([isActive])
  @@map("checklists")
}

model ChecklistItem {
  id             String   @id @default(uuid())
  checklistId    String   @map("checklist_id")
  title          String
  description    String?
  ownerType      String   @default("role") @map("owner_type") // role, user, manager, employee
  ownerId        String?  @map("owner_id")
  ownerRole      String?  @map("owner_role")
  dueOffsetDays  Int      @default(0) @map("due_offset_days")
  isMandatory    Boolean  @default(true) @map("is_mandatory")
  executionOrder Int      @default(1) @map("execution_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  checklist Checklist          @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  runItems  ChecklistRunItem[]

  @@index([checklistId])
  @@map("checklist_items")
}

model ChecklistRun {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  checklistId    String    @map("checklist_id")
  entityType     String    @map("entity_type")
  entityId       String    @map("entity_id")
  status         String    @default("pending") // pending, in_progress, completed, overdue, cancelled
  dueDate        DateTime? @map("due_date")
  createdBy      String?   @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  checklist    Checklist          @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  items        ChecklistRunItem[]

  @@index([organizationId])
  @@index([checklistId])
  @@index([entityType, entityId])
  @@index([status])
  @@map("checklist_runs")
}

model ChecklistRunItem {
  id              String    @id @default(uuid())
  checklistRunId  String    @map("checklist_run_id")
  checklistItemId String?   @map("checklist_item_id")
  title           String
  ownerType       String    @map("owner_type")
  ownerId         String?   @map("owner_id")
  dueDate         DateTime? @map("due_date")
  status          String    @default("pending") // pending, in_progress, completed, skipped, overdue
  completedBy     String?   @map("completed_by")
  completedAt     DateTime? @map("completed_at")
  comments        String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  checklistRun  ChecklistRun   @relation(fields: [checklistRunId], references: [id], onDelete: Cascade)
  checklistItem ChecklistItem? @relation(fields: [checklistItemId], references: [id], onDelete: SetNull)

  @@index([checklistRunId])
  @@index([ownerId])
  @@index([status])
  @@map("checklist_run_items")
}

model Task {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  title          String
  description    String?
  assignedTo     String?   @map("assigned_to")
  assignedBy     String?   @map("assigned_by")
  dueDate        DateTime? @map("due_date")
  priority       String    @default("medium") // low, medium, high, urgent
  status         String    @default("pending") // pending, in_progress, completed, cancelled, overdue
  sourceType     String?   @map("source_type") // workflow, checklist, manual
  sourceId       String?   @map("source_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([assignedTo])
  @@index([status])
  @@index([dueDate])
  @@index([priority])
  @@map("tasks")
}

model Delegation {
  id                 String    @id @default(uuid())
  organizationId     String    @map("organization_id")
  delegateFromUserId String    @map("delegate_from_user_id")
  delegateToUserId   String    @map("delegate_to_user_id")
  module             String?
  requestType        String?   @map("request_type")
  startDate          DateTime  @map("start_date")
  endDate            DateTime  @map("end_date")
  status             String    @default("active") // active, expired, cancelled
  createdBy          String?   @map("created_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([delegateFromUserId])
  @@index([delegateToUserId])
  @@index([status])
  @@map("delegations")
}
