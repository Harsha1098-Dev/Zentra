# ===================================================
# Zentra SaaS Platform - Environment Configuration
# ===================================================

# Application
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000

# Client & Server URLs
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Database (Neon PostgreSQL)
# Pooled connection with -pooler for NestJS runtime
DATABASE_URL="postgresql://neondb_owner:npg_GCQO7c6dTfDb@ep-silent-art-bdvrk9iw-pooler.c-8.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Direct connection without -pooler for Prisma Migrate, Prisma Studio, and introspection
DIRECT_DATABASE_URL="postgresql://neondb_owner:npg_GCQO7c6dTfDb@ep-silent-art-bdvrk9iw.c-8.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Redis Cache & Sessions
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# JWT Authentication
JWT_ACCESS_SECRET=zentra_jwt_access_super_secret_key_change_in_production_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=zentra_jwt_refresh_super_secret_key_change_in_production_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Email / Notification Mock or Provider
EMAIL_FROM_ADDRESS=notifications@zentra.local
EMAIL_FROM_NAME="Zentra Platform"
# Set to 'mock' for local development console logging or 'smtp' for real delivery
EMAIL_PROVIDER=mock
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
