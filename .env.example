# ===================================================
# Zentra SaaS Platform - Environment Configuration Example
# Copy this file to .env and configure your local or Neon credentials.
# Never commit real credentials or secrets to version control.
# ===================================================

# Application
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000

# Client & Server URLs
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Database (Neon PostgreSQL)
# DATABASE_URL is the Neon pooled connection with -pooler in hostname (used by NestJS at runtime)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/zentra?sslmode=require"
# DIRECT_DATABASE_URL is the Neon direct connection without -pooler (used only for Prisma migrations, studio, introspection)
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/zentra?sslmode=require"

# Redis Cache & Sessions
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# JWT Authentication
JWT_ACCESS_SECRET=your_jwt_access_super_secret_key_change_in_production_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_super_secret_key_change_in_production_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Email / Notification Provider (mock or smtp)
EMAIL_FROM_ADDRESS=notifications@zentra.local
EMAIL_FROM_NAME="Zentra Platform"
EMAIL_PROVIDER=mock
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
